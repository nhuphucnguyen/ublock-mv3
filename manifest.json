{
  "manifest_version": 3,
  "name": "uBlock Lite - MV3 Ad Blocker",
  "version": "1.0.0",
  "description": "Fast, battery-efficient Manifest V3 ad blocker inspired by uBlock Origin with Declarative Net Request, cosmetic filtering, and interactive element picker.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "uBlock Lite"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js",
        "content/element-picker.js"
      ],
      "css": [
        "content/element-picker.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "resources/noop.js",
        "resources/noop.txt",
        "resources/noop.html",
        "resources/1x1.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_default",
        "enabled": true,
        "path": "rulesets/ruleset_default.json"
      },
      {
        "id": "ruleset_privacy",
        "enabled": true,
        "path": "rulesets/ruleset_privacy.json"
      },
      {
        "id": "ruleset_annoyances",
        "enabled": true,
        "path": "rulesets/ruleset_annoyances.json"
      },
      {
        "id": "ruleset_social",
        "enabled": false,
        "path": "rulesets/ruleset_social.json"
      }
    ]
  }
}
